# Clave corporativa de EBIS para la práctica (sandbox). NO se versiona ni se entrega.
OPENAI_API_KEY=
# Regla del sandbox: el modelo de chat debe ser gpt-5-nano.
OPENAI_CHAT_MODEL=gpt-5-nano
# Embeddings: "openai" (text-embedding-3-small) o "local" (sentence-transformers). Se decide en el paso 6.
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat con Claude: "anthropic" (por defecto) u "openai".
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Copia este archivo a .env y rellena SOLO las claves. NO se versiona ni se entrega.
EMBEDDING_PROVIDER=local

# Claves (secretas: rellénalas solo en tu .env, nunca aquí)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
