# Copia este archivo como .env (en la raíz) y completa los valores localmente.
# .env está en .gitignore: no lo subas ni lo compartas.
# Se exporta al proceso con scripts/lab.sh; los notebooks respetan las variables ya definidas.

# ── Claves ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
PINECONE_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# ── Pinecone (sesiones 05–07) ──────────────────────────────────────
PINECONE_INDEX_NAME=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Prefijo de los índices de la sesión 06 (1–26 caracteres a-z, 0-9 o guion)
PINECONE_INDEX_PREFIX=

# ── Modelos (opcionales; hay valores por defecto en cada notebook) ──
# Práctica RAG Tenerife
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sesión 07 (generación de UMBRA)
RAG_LLM_MODEL=gpt-4.1-mini

# ── Sesión 07 ──────────────────────────────────────────────────────
# Ruta a la carpeta de la sesión 06 (absoluta o relativa a clases/07-RAG)
SESSION06_DIR=../06-Const-evaluacion

# ── Límites de cuota de embeddings (sesión 06; vacío = sin límite local) ──
OPENAI_EMBEDDING_RPM=
OPENAI_EMBEDDING_TPM=
