# Copia este fichero como .env y rellena tus valores. El .env no se sube nunca a git.

# Clave de OpenAI (la da EBIS). Empieza por sk-
OPENAI_API_KEY=

# Modelo de chat que usa el agente (opcional)
OPENAI_MODEL=gpt-4.1-mini

# Proveedor del modelo de chat: openai (el del curso), anthropic (Claude, con tu cuenta)
# u ollama (local y gratis). Para probar qwen3 en un solo comando, sin cambiar esto: --qwen
LLM_PROVEEDOR=openai

# Clave de Anthropic (solo si LLM_PROVEEDOR=anthropic). Empieza por sk-ant-
ANTHROPIC_API_KEY=

# Modelo de Claude: Haiku 5.5 es el más barato
ANTHROPIC_MODEL=claude-haiku-5-5

# Modelo de Ollama (solo si LLM_PROVEEDOR=ollama). Antes: «ollama pull qwen3:4b-instruct»
OLLAMA_MODEL=qwen3:4b-instruct

# Embeddings del RAG: openai (el del curso) u ollama (local y gratis; Anthropic no tiene embeddings).
# Con ollama: «ollama pull bge-m3» una vez y Ollama arrancado.
RAG_EMBEDDINGS=openai
RAG_OLLAMA_MODEL=bge-m3

# Token del bot de Telegram: te lo da @BotFather en la clase del día 1
TELEGRAM_BOT_TOKEN=
