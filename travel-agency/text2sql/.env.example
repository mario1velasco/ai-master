# Ollama por su API nativa (/api/chat), sin /v1: así devuelve sus tiempos (carga, lectura del prompt, generación)
OLLAMA_BASE_URL=http://localhost:11434
TEXT2SQL_MODEL=qwen3:4b-instruct
# Un único num_ctx y keep_alive para Qwen3-4B en todo el proyecto (PROYECTO.md §5): el agente usa los mismos
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
