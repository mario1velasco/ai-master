# Ollama por su API nativa (/api/chat), sin /v1: así devuelve sus tiempos (carga, lectura del prompt, generación)
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=qwen3:4b-instruct
# Un único num_ctx y keep_alive para Qwen3-4B en todo el proyecto (PROYECTO.md §5): los mismos que text2sql
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# Pasos del grafo antes de cortar con el mensaje fijo (1 vuelta agente → herramientas = 2 pasos)
AGENT_RECURSION_LIMIT=20
# La tool query_db llama a text2sql.ask(), que lee su propio modelo
TEXT2SQL_MODEL=qwen3:4b-instruct
