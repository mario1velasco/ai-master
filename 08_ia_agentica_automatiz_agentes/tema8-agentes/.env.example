# Copia este archivo como .env y elige UNA de las dos opciones.

# Opción A · Modelo local con Ollama (recomendada)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Opción B · Proveedor en la nube con capa gratuita (si tu ordenador no puede con el modelo local)
# Ejemplo con Groq. Consulta en su web los modelos y límites gratuitos vigentes.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=tu_clave_aqui
# LLM_MODEL=nombre_del_modelo

# Sesión 6 · Canal donde se publica el informe diario (webhook entrante de Slack, Teams...)
# INFORME_WEBHOOK_URL=https://hooks.slack.com/services/...
