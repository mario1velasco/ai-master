# Copia este archivo como .env y elige UNA de las dos opciones.

# Opción A · Modelo local con Ollama (recomendada, la misma del Tema 8)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Opción B · Proveedor en la nube compatible con la API de OpenAI
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=tu_clave_aqui
# LLM_MODEL=nombre_del_modelo

# Sesión 1 · Precio orientativo para estimar el coste (euros por millón de tokens)
PRECIO_MILLON_TOKENS=0.5
